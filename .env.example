# Public site URL — used for canonical URLs, sitemap, Open Graph and the resume.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form email delivery (https://resend.com). The FROM address must be on
# a domain you have verified in Resend, e.g. "Website <hello@your-domain.com>".
RESEND_API_KEY=
CONTACT_TO_EMAIL=richkitibwa@gmail.com
CONTACT_FROM_EMAIL=

# Spam protection (Cloudflare Turnstile, free). Leave both empty to disable locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Privacy-friendly analytics (Plausible). Paste the site-specific script URL,
# e.g. https://plausible.io/js/pa-XXXXXXXX.js. Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_SRC=
